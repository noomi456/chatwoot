CHATRING_IMAGE=ghcr.io/noomi456/chatring-conversation-core:sha-FULL_COMMIT_SHA
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine

FRONTEND_URL=https://app-staging.chatring.ai
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
MAILER_SENDER_EMAIL=ChatRing <accounts@chatring.ai>

POSTGRES_DATABASE=chatring_conversation
POSTGRES_USERNAME=chatring
POSTGRES_PASSWORD=generate-and-store-in-dokploy
REDIS_PASSWORD=generate-and-store-in-dokploy
SECRET_KEY_BASE=generate-and-store-in-dokploy
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=generate-and-store-in-dokploy
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=generate-and-store-in-dokploy
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=generate-and-store-in-dokploy
